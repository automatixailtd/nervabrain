# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git python3 ripgrep \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global @opencode/cli

WORKDIR /bridge
COPY bridge/memo-bridge.py ./memo-bridge.py
COPY scripts/check-ai-bridge-security.py ./check-ai-bridge-security.py
COPY prompts /prompts
RUN chmod -R a+rX /bridge /prompts

WORKDIR /tmp

ENV HOME=/home/assistant \
  AI_CREDENTIALS_FILE=/data/ai-credentials.env \
  MEMO_BIND=0.0.0.0 \
  MEMO_PORT=8089 \
  PYTHONUNBUFFERED=1 \
  WEEKLY_PROMPT_FILE=/prompts/weekly-review.md

CMD ["python3", "/bridge/memo-bridge.py"]
